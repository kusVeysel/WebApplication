
@{
    ViewBag.Title = "BoyutGuncelle";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}
@model WebApplication.DB.Boyut

<div class="card">
    <div class="card-header d-flex col-12 justify-content-between">
        <h5 class="font-weight-bold">Boyut Güncelle</h5>
        <a href="/Setup/SizeIndex" class="btn btn-outline-secondary"><i class="la la-arrow-left"></i> Geri Dön</a>
    </div>
    <div class="card-body">
        <div class="row">
                <div class="col-12 col-md-6">
                    <label>Boyut Adı</label>
                    <input type="text" class="form-control" id="SizeName" name="SizeName" value="@Model.BoyutAdi" />
                </div>

                <div class="col-12 col-md-6 h-100">
                    <button class="btn btn-sm btn-success float-right mt-3" onclick="updateSize(@Model.ID)"><i class="la la-check"></i> Güncelle</button>
                </div>
        </div>
    </div>
</div>
@section JS {
    <script src="~/Assets/Custom/Setup.js"></script>
}
