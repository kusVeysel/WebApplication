
@{
    ViewBag.Title = "Boyut Ayarları";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}
@model List<WebApplication.DB.Boyut>

<div class="card">
    <div class="card-body">
        <div class="card-title">
            <div class="row col-12">
                <div class="col-6">
                    Boyut Listesi
                </div>
                <div class="col-6">
                    <a href="/Setup/SizeAdd" class="btn btn-sm btn-success float-right font-weight-bold"><i class="la la-plus"></i> Boyut Ekle</a>
                </div>
            </div>
        </div>
        <table class="table table-striped text-center">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Boyut Adı</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ID</td>
                        <td>@item.BoyutAdi</td>
                        <td>
                            <a href="/Setup/SizeUpdate/@item.ID" class="btn btn-sm btn-warning"><i class="la la-edit"></i> Güncelle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
