 @{
    ViewBag.Title = "Anasayfa";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}
@model WebApplication.Models.HomeVM

<div class="row">
    <div class="col-xl-4 col-lg-6 col-12">
        <div class="card pull-up">
            <div class="card-content">
                <div class="card-body">
                    @if (Model.TotalOrderCount > 0)
                    {
                        <div class="media d-flex">
                            <div class="media-body text-left">
                                <h3 class="success">@Model.TotalOrderCount</h3>
                                <h6>Sipariş Sayısı</h6>
                            </div>
                            <div>
                                <i class="icon-basket-loaded success font-large-2 float-right"></i>
                            </div>
                        </div>
                        <div class="progress progress-sm mt-1 mb-0 box-shadow-2">
                            <div class="progress-bar bg-gradient-x-success" role="progressbar" style="width: 80%" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    }
                    else
                    {
                        <div class="media d-flex">
                            <div class="media-body text-left">
                                <h3 class="danger">0</h3>
                                <h6>Sipariş Sayısı</h6>
                            </div>
                            <div>
                                <i class="icon-basket danger font-large-2 float-right"></i>
                            </div>
                        </div>
                        <div class="progress progress-sm mt-1 mb-0 box-shadow-2">
                            <div class="progress-bar bg-gradient-x-danger" role="progressbar" style="width: 0%" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-6 col-12">
        <div class="card pull-up">
            <div class="card-content">
                <div class="card-body">
                    @if (Model.ActiveTotalCustomerCount > 0)
                    {
                        <div class="media d-flex">
                            <div class="media-body text-left">
                                <h3 class="success">@Model.ActiveTotalCustomerCount</h3>
                                <h6>Aktif Müşteri Sayısı</h6>
                            </div>
                            <div>
                                <i class="icon-users success font-large-2 float-right"></i>
                            </div>
                        </div>
                        <div class="progress progress-sm mt-1 mb-0 box-shadow-2">
                            <div class="progress-bar bg-gradient-x-success" role="progressbar" style="width: 80%" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    }
                    else
                    {
                        <div class="media d-flex">
                            <div class="media-body text-left">
                                <h3 class="danger">0</h3>
                                <h6>Aktif Müşteri Sayısı</h6>
                            </div>
                            <div>
                                <i class="icon-users danger font-large-2 float-right"></i>
                            </div>
                        </div>
                        <div class="progress progress-sm mt-1 mb-0 box-shadow-2">
                            <div class="progress-bar bg-gradient-x-danger" role="progressbar" style="width: 0%" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-6 col-12">
        <div class="card pull-up">
            <div class="card-content">
                <div class="card-body">
                    @if (Model.KritikUrunSayisi > 0)
                    {
                        <div class="media d-flex">
                            <div class="media-body text-left">
                                <h3 class="danger">@Model.KritikUrunSayisi</h3>
                                <h6>Kritik Ürün Sayısı</h6>
                            </div>
                            <div>
                                <i class="la la-fire danger font-large-2 float-right"></i>
                            </div>
                        </div>
                        <div class="progress progress-sm mt-1 mb-0 box-shadow-2">
                            <div class="progress-bar bg-gradient-x-danger" role="progressbar" style="width: 80%" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    }
                    else
                    {
                        <div class="media d-flex">
                            <div class="media-body text-left">
                                <h3 class="success">0</h3>
                                <h6>Kritik Ürün Sayısı</h6>
                            </div>
                            <div>
                                <i class="la la-fire-extinguisher success font-large-2 float-right"></i>
                            </div>
                        </div>
                        <div class="progress progress-sm mt-1 mb-0 box-shadow-2">
                            <div class="progress-bar bg-gradient-x-success" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-12">
    <div class="card">
        <div class="card-body">
            <div class="card-title">
                Son 10 Sipariş
            </div>
            <table class="table table-striped text-center">
                <thead>
                    <tr>
                        <th>Müşteri Adı-Soyadı</th>
                        <th>Ürün Adı</th>
                        <th>Adet</th>
                        <th>Liste Satış Fiyatı</th>
                        <th>Birim Fiyat</th>
                        <th>Sipariş Tarihi</th>
                        <th>İşlemler</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Son10Siparis)
                    {
                        <tr>
                            <td>@item.Musteri.MusteriFirma</td>
                            <td>@item.Urun.UrunAdi</td>
                            <td>@item.Adet</td>
                            <td>@item.ListeSatisFiyat</td>
                            <td>@item.BirimFiyat</td>
                            <td>@item.SiparisTarihi</td>
                            <td>
                                <a href="/Order/Detail/@item.ID" class="btn btn-sm btn-info"><i class="la la-search"></i> Detay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="col-12">
    <div class="card">
        <div class="card-body">
            <div class="card-title">
                <span class="text-danger font-weight-bold">!</span> Kritik Stok Ürünler <span class="text-danger font-weight-bold">!</span>
            </div>
            <table class="table table-striped text-center">
                <thead>
                    <tr>
                        <th>Ürün Adı</th>
                        <th>Kritik Stok Sayısı</th>
                        <th>Stok</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.KritikUrunListe)
                    {
                        <tr>
                            <td>@item.Urun.UrunAdi</td>
                            <td>@item.AlarmSeviyesi</td>
                            <td>@item.Stok</td>
                            <td>
                                <a href="/Product/Detail/@item.UrunID" class="btn btn-sm btn-danger"><i class="la la-search"></i> Detay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>