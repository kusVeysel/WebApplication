
@{
    ViewBag.Title = "Giris";
}
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

<style>
    body {
        height: 100vh;
        align-items: center;
        justify-content: center;
        display: flex;
    }

    .btn:hover {
        cursor: pointer;
        box-shadow: 0px 0px 10px 2px green;
    }
    .kutu {
        position: relative;
        width: 250px;
    }

    input {
        width: 100%;
        padding: 12px;
        background-color: transparent;
        border: 2px solid white;
        outline: none;
        color: white;
        font-size: 16px;
        border-radius: 8px;
    }

    label {
        position: absolute;
        left: 25px;
        top: 8px;
        pointer-events: none;
        color: black;
        transition: 0.3s;
        background-color: white;
        padding: 0 2px;
    }

    input:valid + label,
    input:focus + label {
        top: -8px;
        font-size: 12px;
        color: skyblue;
    }

    input:focus,
    input:valid {
        border: 2px solid skyblue ;
        box-shadow: none !important;
    }
</style>


    <div class="card p-4">
        <h1 class=" text-center mt-2 font-weight-bold font-size-400">Giriş Yap</h1>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-12 kutu" >
                    <input type="text" name="kullanici" id="kullanici" class="form-control mb-3" required/>
                    <label id="kullanicietiket">Kullanıcı adı</label>
                </div>
                <div class="col-12 kutu">
                    <input type="password" name="sifre" id="sifre" class="form-control mb-3" required />
                    <label id="sifreetiket">Sifre</label>
                </div>
            </div>

            <button type="button" class="btn btn-success mt-3" onclick="Giris()" style="width:100%;">Giriş Yap</button>

        </div>
    </div>



<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="~/Assets/Custom/Giris.js"></script>
