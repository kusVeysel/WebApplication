
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}

@model List<WebApplication.Models.SupplierDTO>
<div class="card">
    <div class="card-body">
        <div class="card-title">
            <div class="row col-12">
                <div class="col-6" id="baslik">
                    Tedarikçi Listesi
                </div>
                <div class="col-6">
                    <a href="/Supplier/SupplierInsert" class="btn btn-sm btn-success float-right font-weight-bold"><i class="la la-plus"></i> Tedarikçi Ekle</a>
                </div>
            </div>
        </div>
        <table class="table table-striped text-center">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tedarikçi Adı</th>
                    <th>Telefon</th>
                    <th>Email</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ID</td>
                        <td>@item.Name</td>
                        <td>@item.Phone</td>
                        <td>@item.Email</td>
                        <td>
                            @if (item.IsActive == true)
                            {
                                <a href="#" onclick="supplierStatusUp(@item.ID)"><span class="badge badge-success badge-pill">Aktif</span></a>
                            }
                            else
                            {
                                <a href="#" onclick="supplierStatusUp(@item.ID)"> <span class="badge badge-danger badge-pill">Pasif</span></a>
                            }
                        </td>
                        <td>
                            <a href="/Supplier/SupplierUpdate/@item.ID" class="btn btn-sm btn-warning"><i class="la la-edit"></i> Güncelle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@section JS{
    <script src="~/Assets/Custom/SupplierJS.js"></script>
}


