
@{
    ViewBag.Title = "SupplierInsert";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between">
            <h5 class="font-weight-bold font-size-large">Tedarikçi Ekle</h5>
            <a class="btn btn-outline-secondary" href="/Supplier/Index">Geri</a>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-12 col-md-6">
                <label>Tedarikçi Adı</label>
                <input type="text" class="form-control mb-2" name="Name" id="Name" placeholder="Tedarikçi Adı Giriniz"/>
            </div>
            <div class="col-12 col-md-6">
                <label>Telefon</label>
                <input type="tel" class="form-control mb-2" name="Phone" id="Phone" placeholder="Telefon Numarası Giriniz"/>
            </div>
            <div class="col-12 col-md-6">
                <label>Email</label>
                <input type="email" class="form-control mb-2" name="Email" id="Email" placeholder="Email Adresi Giriniz"/>
            </div>
            <div class="col-12 col-md-6">
                <button class="btn btn-success float-right mt-3" onclick="supplierInsert()"><i class="la la-plus"></i> Tedarikçi Ekle</button>
            </div>
        </div>
    </div>
</div>

@section JS{
    <script src="~/Assets/Custom/SupplierJS.js"></script>
    }