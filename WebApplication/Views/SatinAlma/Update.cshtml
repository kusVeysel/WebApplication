
@{
    ViewBag.Title = "Update";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}


<div class="card">
    <div class=card-header>
        <div class="d-flex justify-content-between">
            <h5 class="font-weight-bold">Satın Alma Güncelleme</h5>
            <a class="btn btn-outline-secondary" href="/SatinAlma/Index">Geri</a>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-2">
           
            <div class="col-12 col-md-6">
                <label>Adet</label>
                <input class="form-control mb-2" name="adet" id="adet" value="@Model.Adet" />
            </div>
            <div class="col-12 col-md-6">
                <label>Birim Fiyat</label>
                <input class="form-control mb-2" name="birimFiyat" id="birimFiyat" value="@Model.BirimFiyat" />
            </div>
            <div class="col-12 col-md-6">
                <label>Toplam Fiyat</label>
                <input class="form-control mb-2" name="toplamFiyat" id="toplamFiyat" value="@Model.ToplamFiyat" />
            </div>
            <div class="col-12 col-md-6">
                <label>İşlem Tarihi</label>
                <input class="form-control mb-2" name="satinAlmaTarih" id="satinAlmaTarih" value="@Model.SatınAlmaTarihi" />
            </div>
            <div class="col-12">
                <button id="btnUpdateSatinAlma" class="btn btn-sm btn-primary float-right" onclick="updateSatinAlma(@Model.UrunID)"><i class="la la-edit"></i>Güncelle</button>
            </div>

        </div>
    </div>
</div>

@section JS{
    <script src="~/Assets/Custom/SatinAlmaJS.js"></script>
}