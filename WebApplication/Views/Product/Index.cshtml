
@{
    ViewBag.Title = "Ürün Listesi";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}

@model List<WebApplication.Models.ProductListVM>
<div class="card">
    <div class="card-body">
        <div class="card-title">
            <div class="row col-12">
                <div class="col-6" id="baslik">
                    Ürün Listesi
                </div>
                <div class="col-6">
                    <a href="/Product/ProductInsert" class="btn btn-sm btn-success float-right font-weight-bold"><i class="la la-plus"></i> Ürün Ekle</a>
                </div>
            </div>
        </div>
        <table class="table table-striped text-center">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ürün Adı</th>
                    <th>Materyal</th>
                    <th>Boyut</th>
                    <th>Stok</th>
                    <th>Stok Alarm</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ID</td>
                        <td>@item.UrunAdi</td>
                        <td>@item.MateryalAdi</td>
                        <td>@item.BoyutAdi</td>
                        <td>@item.Stok</td>
                        <td>
                            @if (item.StokAlarm == true)
                            {
                                <span class="badge badge-danger badge-pill">Kritik Stok</span>
                            }
                            else
                            {
                                <span class="badge badge-success badge-pill">Normal Stok</span>
                            }
                        </td>

                        <td>
                            @if (item.Durum == true)
                            {
                                <a href="#" onclick="productStaUpdate(@item.ID)"><span class="badge badge-success badge-pill">Aktif</span></a>
                            }
                            else
                            {
                                <a href="#" onclick="productStaUpdate(@item.ID)"> <span class="badge badge-danger badge-pill">Pasif</span></a>
                            }
                        </td>
                        <td>
                            <a href="#" onclick="getProductStockInfo(@item.ID)" class="btn btn-sm btn-primary" data-toggle="modal" data-target="#exampleModal"><i class="la la-edit"></i> Stok Güncelle</a>
                            <a href="/Product/Update/@item.ID" class="btn btn-sm btn-warning"><i class="la la-edit"></i> Güncelle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="exampleModalLabel">Ürün Stok Güncelleme</h3>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <h3 class="modal-title" id="productName"></h3>
                <input type="text" name="stockID" id="stockID" value="" hidden />
                <input type="text" name="productID" id="productID" value="" hidden />
                <label>Stok:</label>
                <input class="form-control" type="number" name="stock" id="stock" value="" />
                <label>Alarm Seviyesi:</label>
                <input class="form-control" type="number" name="alarmStock" id="alarmStock" value="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <a href="#" onclick="updateStock()" class="btn btn-warning">Stok Güncelle</a>
            </div>
        </div>
    </div>
</div>


@section JS{
    <script src="~/Assets/Custom/ProductJS.js"></script>
}
